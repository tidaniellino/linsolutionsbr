# ==============================================================================
# LINSOLUTIONS - CONFIGURAÇÕES DE AGENDAMENTO E E-MAIL
# ==============================================================================

# Porta do Servidor Web
PORT=3000

# E-mail que receberá as notificações de reuniões da LinSolutions
ADMIN_EMAIL=contato@linsolutionsbr.com.br

# ------------------------------------------------------------------------------
# SERVIÇO DE E-MAIL (SMTP - Ex: Hostinger, Gmail, Titan, SendGrid, Amazon SES)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.linsolutionsbr.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@linsolutionsbr.com.br
SMTP_PASS=sua_senha_ou_app_password_aqui
EMAIL_FROM="LinSolutions Agendamentos <contato@linsolutionsbr.com.br>"

# ------------------------------------------------------------------------------
# GOOGLE CALENDAR API (Opcional - para verificação e inserção nativa na agenda)
# Caso não configurado, o sistema utiliza o motor de disponibilidade inteligente
# e envia o convite .ics compatível com Google Calendar, Outlook e Apple Calendar.
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=contato@linsolutionsbr.com.br
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
