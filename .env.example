# ==============================================================================
# LINSOLUTIONS - CONFIGURAÇÕES DE AGENDAMENTO, E-MAIL E CALENDÁRIO GODADDY
# ==============================================================================

# Porta do Servidor Web
PORT=3000

# E-mail administrativo oficial da LinSolutions
ADMIN_EMAIL=contato@linsolutionsbr.com

# ------------------------------------------------------------------------------
# SERVIÇO DE E-MAIL GOADDY (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@linsolutionsbr.com
SMTP_PASS=sua_senha_do_email_godaddy
EMAIL_FROM="LinSolutions Agendamentos <contato@linsolutionsbr.com>"

# ------------------------------------------------------------------------------
# SINCRONIZAÇÃO EM TEMPO REAL COM CALENDÁRIO GODADDY / TITAN / OUTLOOK
# ------------------------------------------------------------------------------
# Link iCal (.ics) do seu calendário GoDaddy Webmail / Titan:
# (Obtenha em: Webmail GoDaddy > Calendário > Configurações e Compartilhamento > Link iCal)
GODADDY_CALENDAR_ICS_URL=https://calendar.secureserver.net/subscribe/seu-token-aqui.ics

